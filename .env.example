# ==============================================================================
# LawLLM - AI Legal Intelligence Platform Environment Configuration
# ==============================================================================

# Google Gemini API Key for legal reasoning and RAG summarization
GEMINI_API_KEY=

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL & pgvector Database Settings
# ------------------------------------------------------------------------------
POSTGRES_USER=lawllm
POSTGRES_PASSWORD=lawllm_secure_dev_pw
POSTGRES_DB=lawllm
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# ------------------------------------------------------------------------------
# Production Vector Store & Embedding Configuration
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=10
VECTOR_TOP_K=8
VECTOR_MIN_SIMILARITY=0.60

# ------------------------------------------------------------------------------
# Database Connection URL (Choose according to execution context):
# ------------------------------------------------------------------------------
# 1. Local backend development (outside Docker connecting to PostgreSQL mapped to localhost):
DATABASE_URL=postgresql://lawllm:lawllm_secure_dev_pw@localhost:5432/lawllm

# 2. Containerized backend execution (inside Docker Compose using internal DNS 'postgres'):
# DATABASE_URL=postgresql://lawllm:lawllm_secure_dev_pw@postgres:5432/lawllm
